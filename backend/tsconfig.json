{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "allowJs": true,
    "module": "NodeNext",          // Change from commonjs
    "moduleResolution": "NodeNext", // Add this to handle .js extensions
    "target": "ESNext",            // Upgrade from es2019
    "lib": ["ESNext"],             // Upgrade from es2019
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}